# Django Settings
DJANGO_SECRET_KEY=django-insecure-your-secret-key-here
DEBUG=False
ENV_MODE=production
SECURE_SSL_REDIRECT=False
ALLOWED_HOSTS=localhost,127.0.0.1,web,nginx
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173

# Frontend API URL (use /api for Docker/nginx proxy, http://localhost:8000/api for local dev)
VITE_API_BASE_URL=/api

# Database Settings (PostgreSQL)
DB_NAME=omni_calendar
DB_USER=postgres
DB_PASSWORD=changeme
DB_HOST=db
DB_PORT=5432

# Redis Cache Settings
REDIS_URL=redis://redis:6379/1

# Email Settings (Managed via Admin UI: Choice of SMTP or Postfix)
# DEFAULT_FROM_EMAIL=noreply@omni-calendar.local

# Encryption Key (32 bytes base64) - Required for SMTP passwords
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DJANGO_FERNET_KEY=your-fernet-key-here

# Login/Token endpoint throttle (default: 100/minute)
# LOGIN_THROTTLE_RATE=100/minute
